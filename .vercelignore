# Ignore local/development requirements files so Vercel's Python builder
# uses only api/requirements.txt for the serverless function.
/requirements.txt
/requirements-no-torch.txt
/fastapi-backend/requirements.txt

# Keep small preprocessed DOE CSVs bundled for the EnergyHub predictor;
# other DOE raw datasets remain offloaded to Supabase to stay under the 50 MB limit.
/data/DOE_Data_Extracted/**
!/data/DOE_Data_Extracted/data_v2_preprocessed/
!/data/DOE_Data_Extracted/data_v2_preprocessed/**

# Raw / dev / non-runtime directories
/data/philippine_geojson/
/fastapi-backend/scripts/
/fastapi-backend/tests/
/data/windsurf_data_extraction/
/tests/
/python_scripts/
/data/scraped_data/
/scripts/gap_output/
/data/newDataPointsToExtract/
/data/GeothermalDatasets/
/data/ThesisResearchStudies/
/data/regionalData/
/data/debug_outputs/
/docs/
/supabase/
/expo-mobile/
__pycache__/
*.pyc
*.pyo
.venv/
node_modules/
/react-frontend/dist

# Large archive / geospatial / notebook / markdown files
*.md
*.ipynb
*.tif
*.grib
*.zip

# Heavy RAG / FAISS / wind product files not needed at runtime
/fastapi-backend/app/services/local_data/rag_chunks.json
/fastapi-backend/app/services/local_data/rag_knowledge_base.json
/fastapi-backend/app/services/local_data/rag_faiss.index
/fastapi-backend/app/services/local_data/wind_products_joined.csv
/fastapi-backend/app/services/local_data/wind_products_joined_betz.csv
