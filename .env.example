# Supabase Postgres (prefer DATABASE_URL or SUPABASE_DB_URL)
DATABASE_URL=
SUPABASE_DB_URL=

# If not using a URL, provide discrete fields
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# NASA POWER ingestion settings
START_YEAR=2018
END_YEAR=
ONLY_MISSING=true
BATCH_SIZE=500
NASA_RATE_LIMIT_SECONDS=0.6
NASA_REQUEST_TIMEOUT=30
NASA_MAX_RETRIES=5
NASA_BACKOFF_FACTOR=1.5

# Logging
LOG_LEVEL=INFO
