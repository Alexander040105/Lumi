# Supabase Postgres (prefer DATABASE_URL or SUPABASE_DB_URL)
DATABASE_URL=
SUPABASE_DB_URL=

# If not using a URL, provide discrete fields
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# NASA POWER ingestion settings
START_YEAR=2018
END_YEAR=
ONLY_MISSING=true
BATCH_SIZE=500
NASA_RATE_LIMIT_SECONDS=0.6
NASA_REQUEST_TIMEOUT=30
NASA_MAX_RETRIES=5
NASA_BACKOFF_FACTOR=1.5

# Logging
LOG_LEVEL=INFO

# Elevation ETL settings
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_FACTOR=0.5
HTTP_TIMEOUT_SECONDS=20
RATE_LIMIT_PER_SECOND=4
CONCURRENCY=4
USE_ASYNC=false
DRY_RUN=false
CACHE_TTL_DAYS=365
RESUME_FROM_CACHE=true
