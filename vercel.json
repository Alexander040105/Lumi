{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "installCommand": "pip install -r api/requirements.txt",
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "excludeFiles": "{react-frontend/**,data/**,revisionFiles/**,phl_msk_alt/**,__pycache__/**,*.pyc,*.pyo,.pytest_cache/**}",
      "includeFiles": "{fastapi-backend/**,api/**,DOE_Data_Extracted/data_v2_preprocessed/**}"
    }
  }
}
