{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "cd react-frontend && npm ci && cd .. && pip install -r fastapi-backend/requirements-vercel.txt",
  "buildCommand": "cd react-frontend && npm run build",
  "outputDirectory": "react-frontend/dist",
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "excludeFiles": ".venv/**,fastapi-backend/.venv/**,node_modules/**,react-frontend/**,lumi_tests/**,scraped_data/**",
      "includeFiles": "{fastapi-backend/**,DOE_Data_Extracted/data_v1/*.csv,DOE_Data_Extracted/data_v2_preprocessed/*.csv,DOE_Data_Extracted/**/*.csv,DOE_Data_Extracted/**/*.json,philippine_geojson/*.json}"
    }
  }
}
