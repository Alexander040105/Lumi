APP_NAME=Lumi API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","https://*.vercel.app"]

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Upstash / Vercel KV
UPSTASH_REDIS_URL=

# Optional ML worker for heavy RAG/ETL endpoints. Leave empty to disable those endpoints.
ML_WORKER_URL=

# Disable RAG index building in serverless environments (e.g. Vercel).
ENABLE_RAG=false
