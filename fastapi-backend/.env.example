APP_NAME=Lumi API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","https://*.vercel.app"]

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Upstash / Vercel KV
UPSTASH_REDIS_URL=

# Optional ML worker for heavy RAG/ETL endpoints. Leave empty to disable those endpoints.
ML_WORKER_URL=

# RAG backend: pgvector (Vercel) or faiss (local Docker).
RAG_BACKEND=pgvector
ENABLE_RAG=true

# Embedding provider for serverless RAG.
EMBEDDING_PROVIDER=huggingface-inference
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_TOKEN=
OPENAI_API_KEY=

# Optional: disable cross-encoder rerank (requires sentence-transformers).
RAG_USE_CROSS_ENCODER=false
