VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# On Vercel this should be /api/v1 when the backend is in the same project,
# or the full production API URL (e.g. https://lumi-backend-ten.vercel.app/api/v1).
# The .env.production file pins the current backend URL.
VITE_API_BASE_URL=https://lumi-backend-ten.vercel.app/api/v1

# Free key from https://carto.com/basemaps/apikey — removes the "API key
# required" watermark from basemap tiles. In local dev this is read from the
# repo-root .env (see vite.config.js); in production set CARTO_API_KEY in the
# Vercel project environment.
CARTO_API_KEY=
